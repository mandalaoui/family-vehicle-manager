# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Never commit .env.local. Never use the service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Optional, email reminders (OFF unless REMINDERS_ENABLED=1; see docs/reminders.md). Placeholders only.
# REMINDERS_ENABLED=1
# CRON_SECRET=generate-a-long-random-string
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=YOUR-RESEND-KEY
# EMAIL_FROM=reminders@your-domain.example
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# Optional, performance debugging: log every Supabase round trip (method, path, ms) on the server.
# DEBUG_TIMING=1
